---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { VisitWorkspace } from '../../components/visits/VisitWorkspace';
import { loadDay, isVisitStaff } from '../../lib/visits';
const user = Astro.locals.user;
if (!user || !isVisitStaff(user.role)) return Astro.redirect('/login');
const id = Number(Astro.params.id);
if (!Number.isSafeInteger(id) || id < 1) return Astro.redirect('/citas');
const day = await loadDay(user, undefined, id);
if (!day.visits.length) return Astro.redirect('/citas');
---
<DashboardLayout title="Atención a domicilio" pageTitle="Visita">
  <VisitWorkspace client:load initial={day} visitId={id} />
</DashboardLayout>
