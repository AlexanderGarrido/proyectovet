---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { DayPanel } from '../../components/visits/DayPanel';
import { loadDay, isVisitStaff } from '../../lib/visits';
const user = Astro.locals.user;
if (!user || !isVisitStaff(user.role)) return Astro.redirect('/login');
const day = await loadDay(user);
---
<DashboardLayout title="Hoy" pageTitle="Mi jornada">
  <DayPanel client:load initial={day} />
</DashboardLayout>
