---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { StockLocations } from '../../components/inventory/StockLocations';
import { KitPreparation } from '../../components/inventory/KitPreparation';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/login');
if (!['admin', 'veterinario', 'recepcionista'].includes(user.role)) return Astro.redirect('/dashboard');
---

<DashboardLayout title="Botiquín" pageTitle="Botiquín">
  <div class="space-y-4">
    <KitPreparation client:load />
    <StockLocations client:load userRole={user.role} />
  </div>
</DashboardLayout>
