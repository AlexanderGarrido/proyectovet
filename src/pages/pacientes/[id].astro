---
import { OwnerEditor } from '../../components/patients/OwnerEditor';
import { hasPermission } from '../../lib/permissions';
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { PatientProfileTabs } from '../../components/patients/PatientProfileTabs';
import { AttendNowButton } from '../../components/patients/AttendNowButton';
import { features } from '../../lib/features';
import { db } from '../../db';
import { patients, owners } from '../../db/schema/patients';
import { medicalRecords } from '../../db/schema/medical';
import { appointments } from '../../db/schema/appointments';
import { eq, desc, sql } from 'drizzle-orm';
import { format } from 'date-fns';
import { es } from 'date-fns/locale';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/login');

const id = Number(Astro.params.id);
const [patient] = await db
  .select({
    id: patients.id, name: patients.name, species: patients.species,
    breed: patients.breed, color: patients.color, sex: patients.sex,
    dateOfBirth: patients.dateOfBirth, weight: patients.weight,
    microchipNumber: patients.microchipNumber, notes: patients.notes,
    isActive: patients.isActive, ownerId: patients.ownerId,
    hasPhoto: sql<boolean>`${patients.photo} IS NOT NULL`,
    updatedAt: patients.updatedAt,
    ownerFirstName: owners.firstName, ownerLastName: owners.lastName,
    ownerEmail: owners.email, ownerPhone: owners.phone,
  })
  .from(patients)
  .leftJoin(owners, eq(patients.ownerId, owners.id))
  .where(eq(patients.id, id));

if (!patient) return Astro.redirect('/pacientes');

// Independientes entre sí → en paralelo en vez de una tras otra.
const [records, appts] = await Promise.all([
  db.select().from(medicalRecords).where(eq(medicalRecords.patientId, id)).orderBy(desc(medicalRecords.date)).limit(30),
  db.select().from(appointments).where(eq(appointments.patientId, id)).orderBy(desc(appointments.scheduledAt)).limit(30),
]);

const canEdit = hasPermission(user.role, 'medical-records', 'write');
const canEditPatient = hasPermission(user.role, 'patients', 'write');
const canManageOwners = hasPermission(user.role, 'owners', 'write');
const speciesEmoji: Record<string, string> = { perro: '🐕', gato: '🐈', ave: '🐦', conejo: '🐇', reptil: '🦎', roedor: '🐭', otro: '🐾' };
---

<DashboardLayout title={patient.name} pageTitle="Ficha del paciente">
  <nav aria-label="Ruta de navegación" class="mb-5 text-sm">
    <a href="/pacientes" class="text-primary hover:underline focus-visible:underline">Pacientes</a>
    <span class="mx-2 text-muted-foreground" aria-hidden="true">/</span>
    <span aria-current="page">{patient.name}</span>
  </nav>

  <header class="mb-6 flex flex-wrap items-center justify-between gap-4 rounded-xl border bg-card p-4 sm:p-5">
    <div class="flex min-w-0 items-center gap-4">
      <div class="flex h-16 w-16 shrink-0 items-center justify-center overflow-hidden rounded-xl bg-accent sm:h-20 sm:w-20">
        {patient.hasPhoto ? <img src={`/api/patients/${id}/photo?v=${encodeURIComponent(patient.updatedAt.toISOString())}`} alt={`Foto de ${patient.name}`} class="h-full w-full object-cover" /> : <span class="text-4xl" aria-hidden="true">{speciesEmoji[patient.species] || '🐾'}</span>}
      </div>
      <div class="min-w-0">
        <div class="flex flex-wrap items-center gap-2">
          <h1 class="truncate text-2xl font-semibold tracking-tight sm:text-3xl">{patient.name}</h1>
          {!patient.isActive && <span class="rounded-full bg-red-100 px-2 py-0.5 text-xs font-medium text-red-700">Inactivo</span>}
        </div>
        <p class="mt-1 text-sm capitalize text-muted-foreground">{patient.species}{patient.breed ? ` · ${patient.breed}` : ''}</p>
      </div>
    </div>
    <div class="flex w-full flex-wrap gap-2 sm:w-auto">
      {canEditPatient && <a href={`/pacientes/${id}/editar`} class="inline-flex min-h-11 items-center justify-center rounded-lg border px-4 text-sm font-medium hover:bg-muted focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">Editar ficha</a>}
      {features.atencionSinCita && canEdit && patient.isActive && <AttendNowButton client:load userId={user.id} patientId={id} />}
      {hasPermission(user.role, 'appointments', 'write') && <a href={`/citas/nueva?patientId=${id}`} class="inline-flex min-h-11 items-center justify-center rounded-lg border px-4 text-sm font-medium hover:bg-muted focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">Agendar cita</a>}
    </div>
  </header>

  <div class="grid items-start gap-5 lg:grid-cols-[minmax(240px,300px)_minmax(0,1fr)]">
    <!-- Info principal -->
    <div class="lg:col-span-1 space-y-4">
      <div class="rounded-xl border bg-card p-5">
        <h2 class="font-semibold">Datos del paciente</h2>
        <dl class="mt-4 space-y-3 text-sm">
          <div class="flex justify-between gap-3"><dt class="text-muted-foreground">Sexo</dt><dd class="capitalize">{patient.sex}</dd></div>
          {patient.color && <div class="flex justify-between gap-3"><dt class="text-muted-foreground">Color</dt><dd class="text-right">{patient.color}</dd></div>}
          {patient.weight && <div class="flex justify-between gap-3"><dt class="text-muted-foreground">Peso registrado</dt><dd>{patient.weight} kg</dd></div>}
          {patient.dateOfBirth && <div class="flex justify-between gap-3"><dt class="text-muted-foreground">Nacimiento</dt><dd>{format(new Date(`${patient.dateOfBirth}T12:00:00`), 'dd/MM/yyyy', { locale: es })}</dd></div>}
          {patient.microchipNumber && <div class="flex flex-wrap justify-between gap-2"><dt class="text-muted-foreground">Microchip</dt><dd class="break-all font-mono text-xs">{patient.microchipNumber}</dd></div>}
        </dl>
      </div>

      <!-- Tutor -->
      <div class="rounded-xl border bg-card p-5">
        <h3 class="font-semibold mb-3">Responsable</h3>
        <a href={`/tutores/${patient.ownerId}`} class="font-medium text-primary hover:underline">{patient.ownerFirstName} {patient.ownerLastName}</a>
        {patient.ownerPhone && <p class="mt-2 text-sm"><a href={`tel:${patient.ownerPhone}`} class="hover:underline">{patient.ownerPhone}</a></p>}
        {patient.ownerEmail && <p class="mt-1 break-all text-sm"><a href={`mailto:${patient.ownerEmail}`} class="hover:underline">{patient.ownerEmail}</a></p>}
        {canManageOwners && <OwnerEditor client:load ownerId={patient.ownerId} />}
      </div>

      {patient.notes && (
        <div class="rounded-xl border bg-card p-5">
          <h3 class="font-semibold mb-2">Notas</h3>
          <p class="text-sm text-muted-foreground">{patient.notes}</p>
        </div>
      )}
    </div>

    <!-- Historial -->
    <div class="min-w-0">
      <PatientProfileTabs client:load patientId={id} canEdit={canEdit} canWriteAppointments={hasPermission(user.role, 'appointments', 'write')} canWritePrescriptions={hasPermission(user.role, 'prescriptions', 'write')} canWriteLabOrders={hasPermission(user.role, 'lab-orders', 'write')} canWriteConsents={hasPermission(user.role, 'consents', 'write')} canReadPrescriptions={hasPermission(user.role, 'prescriptions', 'read')} canReadLabOrders={hasPermission(user.role, 'lab-orders', 'read')} canReadConsents={hasPermission(user.role, 'consents', 'read')} records={records} appointments={appts} />
    </div>
  </div>
</DashboardLayout>
