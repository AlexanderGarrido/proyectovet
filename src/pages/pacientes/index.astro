---
import { hasPermission } from '../../lib/permissions';
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { PatientList } from '../../components/patients/PatientList';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/login');
---

<DashboardLayout title="Pacientes" pageTitle="Pacientes">
  <header class="mb-5 flex flex-wrap items-start justify-between gap-3">
    <div>
      <h1 class="text-xl font-semibold tracking-tight">Directorio de pacientes</h1>
      <p class="mt-1 text-sm text-muted-foreground">Busca una ficha por mascota, responsable o teléfono.</p>
    </div>
    {hasPermission(user.role, 'owners', 'read') && <a href="/tutores" class="inline-flex min-h-11 items-center rounded-lg border bg-card px-4 text-sm font-medium text-primary hover:bg-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">Ver responsables</a>}
  </header>
  <nav class="mb-5 flex flex-wrap gap-2 text-sm" aria-label="Documentos clínicos">
    {hasPermission(user.role, 'prescriptions', 'read') && <a class="rounded-lg border bg-card px-3 py-2 text-primary hover:bg-accent focus-visible:outline-2 focus-visible:outline-primary" href="/recetas">Recetas</a>}
    {hasPermission(user.role, 'lab-orders', 'read') && <a class="rounded-lg border bg-card px-3 py-2 text-primary hover:bg-accent focus-visible:outline-2 focus-visible:outline-primary" href="/ordenes">Laboratorio</a>}
    {hasPermission(user.role, 'consents', 'read') && <a class="rounded-lg border bg-card px-3 py-2 text-primary hover:bg-accent focus-visible:outline-2 focus-visible:outline-primary" href="/consentimientos">Consentimientos</a>}
  </nav>
  <PatientList client:load />
</DashboardLayout>
