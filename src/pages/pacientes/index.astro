---
import { hasPermission } from '../../lib/permissions';
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { PatientList } from '../../components/patients/PatientList';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/login');
---

<DashboardLayout title="Pacientes" pageTitle="Pacientes">
  <nav class="flex flex-wrap gap-4 mb-5 text-sm text-primary" aria-label="Documentos clínicos">
    {hasPermission(user.role, 'prescriptions', 'read') && <a href="/recetas">Recetas</a>}
    {hasPermission(user.role, 'lab-orders', 'read') && <a href="/ordenes">Laboratorio</a>}
    {hasPermission(user.role, 'consents', 'read') && <a href="/consentimientos">Consentimientos</a>}
  </nav>
  <PatientList client:load />
</DashboardLayout>
